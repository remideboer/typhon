# Panic is an outcome, not Typhon syntax. This file is the entrypoint selected by
# typhon.toml, so its top-level propagation may hand an error to the runtime.
#
# Expected stdout: no output
# Expected stderr:
# Typhon panic: missing count
#   at <project>/app.typhon:14 in start
#   at <project>/app.typhon:18 in <entrypoint>
# Expected exit status: 1

import loadCount from loader.typhon

function result<int, string> start() {
    int count = loadCount() propagate
    return ok(count)
}

int count = start() propagate
print(count) # Not reached.
