# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# VS Code — ignore personal IDE files; keep shared workspace recommendations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Pytest
.pytest_cache/

# Editor directories and files
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Temp files
*.log
*.tmp

# Coverage
.coverage
htmlcov/

# PyInstaller
*.manifest
*.spec

# Python bytecode
*.pyc
*.pyo
*.pyd

# Environment files
.env
.env.*

# Misc
*.swp

# Local scratchpad drafts (not project memory — see docs/adr/README.md)
requirements/

# JS emit / npm (target-dependent examples)
**/node_modules/
**/.typhon_js_out/

# Typhon VS Code extension build output
typhon-language/bundled/
typhon-language/*.vsix
typhon-language/LICENSE
examples/test_area/refactor.typhon

# Webserver local TLS (ops/dev generate; never commit)
examples/webserver/certs/*.pem
examples/webserver/certs/*.key
examples/webserver/certs/openssl.cnf
examples/webserver/certs/openssl.conf
